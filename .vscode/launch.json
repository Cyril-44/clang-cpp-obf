{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug cppobf",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/cppobf",
      "args": [
        "--allow-external",
        "--process-macros",
        "${workspaceFolder}/victim.cpp"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
